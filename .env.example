# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Deixe vazio ou FALSE para usar o Google AI Studio (não Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=
# Modelo Gemini dos agentes (vazio = gemini-2.5-flash)
AURORA_MODEL=
# Caminho do banco SQLite com sessões e dados (vazio = var/aurora.db)
AURORA_DB_PATH=
